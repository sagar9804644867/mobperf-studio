              <stringProp name="script">// mobperf:think - Parameters = "&lt;recorded ms&gt; &lt;default variation %&gt;"; -Jthink_ms and -Jthink_dev_pct override
String[] a = ((Parameters ?: '').trim() ?: '0').split(/\s+/)
long rec = a[0] as long
int defPct = a.length &gt; 1 ? (a[1] as int) : 20
String t = (props.getProperty('think_ms') ?: '').trim()
long base = t ? (t as long) : rec
String dp = (props.getProperty('think_dev_pct') ?: '').trim()
int pct = Math.max(0, Math.min(dp ? (dp as int) : defPct, 100))
long d = (base * pct).intdiv(100)
return Math.max(0L, base - d + (long) (Math.random() * (2 * d + 1)))</stringProp>
            </JSR223Timer>
            <hashTree />
          </hashTree>
        </hashTree>
        <TestAction guiclass="TestActionGui" testclass="TestAction" testname="Pacing - wait for the rest of the iteration" enabled="true">
          <intProp name="ActionProcessor.action">1</intProp>
          <intProp name="ActionProcessor.target">0</intProp>
          <stringProp name="ActionProcessor.duration">0</stringProp>
        </TestAction>
        <hashTree>
          <JSR223Timer guiclass="TestBeanGUI" testclass="JSR223Timer" testname="Pacing (off, set -Jpacing_ms)" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters">0</stringProp>
            <stringProp name="filename" />
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// mobperf:pacing_end - each iteration lasts at least pacing ms. Parameters = default; -Jpacing_ms overrides (0 = off)
String pp = (props.getProperty('pacing_ms') ?: '').trim()
long pacing = pp ? (pp as long) : (((Parameters ?: '').trim() ?: '0') as long)
Object start = vars.getObject('mobperf_iteration_start')
if (pacing &lt;= 0 || start == null) return 0L
long left = pacing - (System.currentTimeMillis() - (start as long))
if (left &lt; 0) log.warn('Iteration took ' + (pacing - left) + ' ms, longer than pacing_ms=' + pacing)
return Math.max(0L, left)</stringProp>
          </JSR223Timer>
          <hashTree />
        </hashTree>
      </hashTree>
      <ResultCollector guiclass="ViewResultsFullVisualizer" testclass="ResultCollector" testname="View Results Tree" enabled="true">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <stringProp name="filename" />
      </ResultCollector>
      <hashTree />
      <ResultCollector guiclass="SummaryReport" testclass="ResultCollector" testname="Summary Report" enabled="true">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <stringProp name="filename" />
      </ResultCollector>
      <hashTree />
    </hashTree>
  </hashTree>
</jmeterTestPlan>