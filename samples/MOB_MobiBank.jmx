          <TestAction guiclass="TestActionGui" testclass="TestAction" testname="Think Time - AppLaunch" enabled="true">
            <intProp name="ActionProcessor.action">1</intProp>
            <intProp name="ActionProcessor.target">0</intProp>
            <stringProp name="ActionProcessor.duration">0</stringProp>
          </TestAction>
          <hashTree>
            <JSR223Timer guiclass="TestBeanGUI" testclass="JSR223Timer" testname="Think Time 500 ms +/- 20%" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters">500 20</stringProp>
              <stringProp name="filename" />
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">// mobperf:think - Parameters = "&lt;recorded ms&gt; &lt;default variation %&gt;"; -Jthink_ms and -Jthink_dev_pct override
String[] a = ((Parameters ?: '').trim() ?: '0').split(/\s+/)
long rec = a[0] as long
int defPct = a.length &gt; 1 ? (a[1] as int) : 20
String t = (props.getProperty('think_ms') ?: '').trim()
long base = t ? (t as long) : rec
String dp = (props.getProperty('think_dev_pct') ?: '').trim()
int pct = Math.max(0, Math.min(dp ? (dp as int) : defPct, 100))
long d = (base * pct).intdiv(100)
return Math.max(0L, base - d + (long) (Math.random() * (2 * d + 1)))</stringProp>
            </JSR223Timer>
            <hashTree />
          </hashTree>
        </hashTree>
