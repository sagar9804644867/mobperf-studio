            <stringProp name="Argument.value">${__P(host_server,127.0.0.1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">recorded host</stringProp>
          </elementProp>
          <elementProp name="host_server_protocol" elementType="Argument">
            <stringProp name="Argument.name">host_server_protocol</stringProp>
            <stringProp name="Argument.value">${__P(host_server_protocol,http)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="host_server_port" elementType="Argument">
            <stringProp name="Argument.name">host_server_port</stringProp>
            <stringProp name="Argument.value">${__P(host_server_port,48311)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">empty = default port</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
