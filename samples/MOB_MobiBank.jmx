  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="MobPerf - MobiBank" enabled="true">
      <stringProp name="TestElement.comments">Generated by MobPerf Studio. Correlated, parameterised and named automatically from a mobile emulator recording. Override any setting from the command line, e.g. -Jusers=50 -Jrampup=300 -Jloops=10 -Jthink_ms=3000</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
